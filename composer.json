{
    "name": "packstub/filament-features",
    "description": "Feature flags and entitlements for Filament tenants — plan-based features and limits, per-tenant overrides, kill switches, usage checks, and gating for pages, actions, routes and Blade.",
    "keywords": ["packstub", "laravel", "filament", "filament-plugin", "filament-v5", "feature-flags", "entitlements", "plans", "limits", "multi-tenancy", "saas", "pennant"],
    "homepage": "https://packstub.dev",
    "support": {"email": "support@packstub.dev", "issues": "https://github.com/packstub/filament-features/issues", "docs": "https://packstub.dev/docs/filament-features"},
    "type": "library",
    "license": "proprietary",
    "authors": [{"name": "Packstub", "email": "support@packstub.dev", "homepage": "https://packstub.dev"}],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "suggest": {"packstub/filament-teams": "Drive team seat limits from a plan feature."},
    "autoload": {"psr-4": {"Packstub\\Features\\": "src/"}},
    "autoload-dev": {"psr-4": {"Packstub\\Features\\Tests\\": "tests/"}},
    "scripts": {"test": "pest", "test:filter": "pest --filter", "lint": "vendor/bin/pint", "lint:test": "vendor/bin/pint --test"},
    "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
    "extra": {"laravel": {"providers": ["Packstub\\Features\\FeaturesServiceProvider"]}, "branch-alias": {"dev-main": "1.x-dev"}},
    "minimum-stability": "dev",
    "prefer-stable": true
}
